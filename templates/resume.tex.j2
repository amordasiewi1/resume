% ------------------------------------------------------------

((* elif section.entries and section.entries[0].kind == "publication" *))

\resumeSubHeadingListStart

((* for entry in section.entries *))
\item \small{
((* for author in entry.authors *))((* if author.highlight *))\textbf{((( author.name | latex )))}((* else *))((( author.name | latex )))((* endif *))((* if not loop.last *))((* if loop.revindex == 2 *)), and ((* else *)), ((* endif *))((* endif *))((* endfor *)),
``((( entry.title | latex )))'', ((* if entry.venue *))in \textit{((( entry.venue | latex )))}, ((* endif *))((* if entry.location *))((( entry.location | latex ))), ((* endif *))((* if entry.year *))((( entry.year ))), ((* endif *))((* if entry.identifier *))((( entry.identifier | latex ))) ((* endif *))((* if entry.url *))(\href{((( entry.url )))}{\underline{((( entry.url | latex )))}})((* endif *)).
}
((* endfor *))

\resumeSubHeadingListEnd


% ------------------------------------------------------------
% SKILLS
% ------------------------------------------------------------

((* elif section.entries and section.entries[0].kind == "skills" *))

\begin{itemize}[leftmargin=0.15in, label={}]

((* for entry in section.entries *))

    \small{\item{

    ((* for group in entry.groups *))

        \textbf{((( group.name | latex )))}:
        ((( group.skills | join(", ") | latex )))

        ((* if not loop.last *))
            \par
        ((* endif *))

    ((* endfor *))

    }}

((* endfor *))

\end{itemize}


