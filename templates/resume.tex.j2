((* if section.entries and section.entries[0].kind == "education" *))

\resumeSubHeadingListStart

((* for entry in section.entries *))

\item

\begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}

    \textbf{((( entry.institution | latex )))} &
    ((( entry.location | latex ))) \\[-1pt]

    ((* for degree in entry.degrees *))

        \small
        ((( degree.degree | latex )))
        &
        \small
        ((( (degree.dates.display() if degree.dates else "") | latex )))
        \\[-1pt]

        \small
        \hspace{1.25em}

        ((* if "M.S." in degree.degree *))

            ((* if degree.concentrations *))
                \textit{Major Concentration:}
                ((( degree.concentrations | join(", ") | latex )))
            ((* endif *))

            ((* if degree.concentrations and degree.minors *))
                \enspace $|$ \enspace
            ((* endif *))

            ((* if degree.minors *))
                \textit{Minor Concentration:}
                ((( degree.minors | join(", ") | latex )))
            ((* endif *))

        ((* else *))

            ((* if degree.concentrations *))
                \textit{Concentration:}
                ((( degree.concentrations | join(", ") | latex )))
            ((* endif *))

            ((* if degree.concentrations and degree.minors *))
                \enspace $|$ \enspace
            ((* endif *))

            ((* if degree.minors *))
                \textit{Minor:}
                ((( degree.minors | join(", ") | latex )))
            ((* endif *))

        ((* endif *))

        &

        ((* if degree.gpa *))
            \small GPA: ((( degree.gpa | latex )))
        ((* endif *))

        \\[2pt]

    ((* endfor *))

\end{tabular*}

\vspace{1pt}

((* for bullet in entry.bullets *))
{\small
    ((( bullet | latex )))
    \par
}
\vspace{1pt}
((* endfor *))

((* if entry.coursework *))
{\small
    \textbf{Relevant Coursework:}
    ((( entry.coursework | join(", ") | latex )))
    \par
}
\vspace{1pt}
((* endif *))

((* if entry.interests *))
{\small
    \textbf{Interests:}
    ((( entry.interests | join(", ") | latex )))
    \par
}
((* endif *))

((* endfor *))

\resumeSubHeadingListEnd

\vspace{-10pt}


