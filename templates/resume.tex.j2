((* elif section.entries and section.entries[0].kind == "experience" *))

\resumeSubHeadingListStart

((* for entry in section.entries *))

    \resumeSubheading
        {((( entry.title | latex )))}
        {((( entry.dates.display() if entry.dates else "" | latex )))}
        {((( entry.organization | latex )))}
        {((( entry.location | latex )))}

    ((* if entry.bullets *))

        \resumeItemListStart

        ((* for bullet in entry.bullets *))

            \resumeItem{
                ((( bullet | latex )))
            }

        ((* endfor *))

        \resumeItemListEnd

    ((* endif *))

((* endfor *))

\resumeSubHeadingListEnd


